model StockGuanJianWantou {
    id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
    user_id    BigInt?   @db.UnsignedBigInt
    vari       String?   @db.VarChar(255) // 品种
    tech       String?   @db.VarChar(255) // 工艺
    r          String?   @db.VarChar(255) // R值
    surface    String?   @db.VarChar(255) // 表面
    mate       String?   @db.VarChar(255) // 材质
    spec       String?   @db.VarChar(255) // 规格
    number     String?   @db.VarChar(255) // 数量
    remarks    String?   @db.VarChar(255) // 备注
    created_at DateTime? @db.Timestamp(3)
    updated_at DateTime? @db.Timestamp(3)
    deleted_at DateTime? @db.Timestamp(3)

    @@map(name: "stock_guan_jian_wantous")
    @@index([user_id], name: "stock_guan_jian_wantous_user_id_foreign")
}

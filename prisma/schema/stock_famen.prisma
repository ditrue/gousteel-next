model StockFamen {
    id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
    user_id    BigInt   @db.UnsignedBigInt
    vari       String   @db.VarChar(8) // 品种
    mate       String   @db.VarChar(8) // 材质
    caliber    String   @db.VarChar(16) // 规格
    model      String   @db.VarChar(255) // 规格
    standard   String   @db.VarChar(255) // 标准
    number     Int      @db.Int // 支数
    remarks    String   @db.VarChar(255) // 重量
    created_at DateTime? @db.Timestamp(3)
    updated_at DateTime? @db.Timestamp(3)
    deleted_at DateTime? @db.Timestamp(3)

    @@map(name: "stock_famens")
    @@index([user_id], name: "stock_famens_user_id_foreign")
}

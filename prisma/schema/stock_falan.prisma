model StockFalan {
    id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
    user_id    BigInt   @db.UnsignedBigInt
    vari       String   @db.VarChar(8) // 品种
    standard   String   @db.VarChar(255) // 标准
    mate       String   @db.VarChar(255) // 材质
    caliber    String   @db.VarChar(16) // 口径
    number     Int      @db.Int // 支数
    remarks    String   @db.VarChar(255) // 重量
    created_at DateTime? @db.Timestamp(3)
    updated_at DateTime? @db.Timestamp(3)
    deleted_at DateTime? @db.Timestamp(3)

    @@map(name: "stock_falans")
    @@index([user_id], name: "stock_falans_user_id_foreign")
}
